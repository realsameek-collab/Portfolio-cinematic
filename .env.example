# Contact form email delivery (server-side only — never prefix these with NEXT_PUBLIC_)
# 1. Create a free account at https://resend.com
# 2. Create an API key at https://resend.com/api-keys
# 3. Copy this file to .env.local and paste the key below
RESEND_API_KEY=

# Where contact form messages are delivered. Defaults to ameek263@gmail.com.
CONTACT_TO_EMAIL=ameek263@gmail.com

# Sender address. Resend's shared test sender works immediately and can only
# deliver to the email you signed up with. Once you verify your own domain at
# https://resend.com/domains, change this to something like
# "Abdullah <hello@yourdomain.com>".
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# Public site URL, used for Open Graph metadata. Set to the deployed URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3002
